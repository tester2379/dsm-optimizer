{
  "name": "dsm-optimizer",
  "version": "1.3.0",
  "description": "DSM Windows Optimizer — system monitoring, optimization & call-home",
  "main": "main.js",
  "author": "DSM Communications",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build-installer": "electron-builder --win nsis",
    "build-all": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.dsm.optimizer",
    "productName": "Windows Optimizer",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "artifactName": "Windows-Optimizer-Setup-${version}.exe",
      "shortcutName": "Windows Optimizer",
      "menuCategory": "DSM Communications"
    },
    "portable": {
      "artifactName": "Optimizer.exe"
    },
    "files": [
      "**/*",
      "!logs/**",
      "!dist/**",
      "!*.md"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "nat-upnp": "^1.1.1"
  }
}
